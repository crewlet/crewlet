{
  "name": "@crewlet/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Crewlet dashboard. Built into ../static/dashboard, which the engine binary embeds.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.protocol.config.ts && vite build --config vite.runtime.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/owned-tmpdir.mjs vitest run",
    "test:layout": "node scripts/owned-tmpdir.mjs vitest run --config vitest.layout.config.ts",
    "test:watch": "node scripts/owned-tmpdir.mjs vitest",
    "bench": "node scripts/owned-tmpdir.mjs vitest bench --run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@crewlethq/artifact-kit": "0.125.0",
    "@crewlethq/icons": "0.125.0",
    "@crewlethq/tokens": "0.125.0",
    "@crewlethq/ui": "0.125.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "30.1.3",
    "jsqr": "1.4.0",
    "playwright": "1.65.0",
    "prettier": "3.10.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
