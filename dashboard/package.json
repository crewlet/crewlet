{
  "name": "@crewlet/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Crewlet dashboard. Built into ../static/dashboard, which the engine binary embeds.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.protocol.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
