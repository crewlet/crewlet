{
  "name": "@crewlet/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Crewlet dashboard. Built into ../static/dashboard, which the engine binary embeds.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.protocol.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@crewlethq/icons": "0.4.4",
    "@crewlethq/tokens": "0.4.4",
    "@crewlethq/ui": "0.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
