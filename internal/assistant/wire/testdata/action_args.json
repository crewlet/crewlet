  "spend.range.set": {
    "type": "object",
    "description": "The page's own settings to change, by name; leave out what stays.",
    "additionalProperties": false,
    "properties": {
      "window": {
        "type": [
          "string",
          "null"
        ],
        "description": "Window. One of 7d, 30d, 90d, or a custom window written <from>/<to> in ISO 8601 UTC. null clears it.",
        "maxLength": 200
      }
    },
    "examples": [
      {
        "window": null
      }
    ]
  },
