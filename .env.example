# Crewlet Docker Compose environment
# Copy to .env and adjust as needed: cp .env.example .env

# PostgreSQL (with TimescaleDB + pgvector preloaded)
POSTGRES_USER=crewlet
POSTGRES_PASSWORD=crewlet
POSTGRES_DB=crewlet

# Dekaf (Pulsar UI) public URL. Leave as localhost for local use; when
# running on a remote server set this to the address you open in the
# browser so the UI's API calls reach the server (not your localhost).
# DEKAF_PUBLIC_BASE_URL=http://your-server-ip:8090

# Pulsar token auth (only when the broker has auth enabled — see
# docs/guides/deployment.md "Authentication").
# PULSAR_ADMIN_TOKEN=...     # operator/superuser token (broker + healthcheck + pulsar-admin)
# CREWLET_PULSAR_TOKEN=...   # this engine's token (referenced from config.yaml auth_token)

# Slack app provisioning (`crewlet slack provision` — see
# docs/integrations/slack.md). Generate once at api.slack.com/apps →
# "Your App Configuration Tokens"; the provisioner rotates the pair near
# expiry and writes the fresh values (plus SLACK_CONFIG_TOKEN_EXPIRES_AT)
# back to its env file, which is authoritative from then on. Per-agent
# SLACK_BOT_TOKEN_* / SLACK_SIGNING_SECRET_* vars are written there too.
# SLACK_CONFIG_TOKEN=xoxe.xoxp-...
# SLACK_CONFIG_REFRESH_TOKEN=xoxe-1-...
