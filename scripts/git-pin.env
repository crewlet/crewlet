# The gits the engine is built and tested with, each a release tarball named by its version and SHA-256 (kernel.org's
# git-<version>.tar.xz). scripts/git.sh builds them — the one recipe the engine image, CI and a contributor's
# `make git` share — and nothing else in the tree spells their versions: the Dockerfile copies this file in, the
# Makefile asks scripts/git.sh, and ci.yml keys its cache on this file and the recipe.
#
# No Dependabot ecosystem watches a source tarball. A bump changes a version and its SHA-256 TOGETHER, the digest
# taken from kernel.org's sha256sums.asc once the release's signature (git-<version>.tar.sign, over the
# decompressed tar) has verified against the git maintainer's key; then `make git` and `make check`. A diff to this
# file changes the git every git node runs, so it is read as release surface.
#
# node: the newest git release — what the engine image builds, and what every pool and client in the suite runs.
GIT_NODE_VERSION=2.56.0
GIT_NODE_SHA256=26c56c296b38c0695b26fa95f475f1d01704d2d38e73465ca30b0b2f5dc789d3
# node-floor: the newest patch of git 2.55, the oldest series that writes an incremental multi-pack-index layer over
# a NAMED base with no chain file (`multi-pack-index write --incremental --base --no-write-chain-file`).
GIT_NODE_FLOOR_VERSION=2.55.0
GIT_NODE_FLOOR_SHA256=457fdb04dc8728e007d4688695e6912e6f680727920f2a40bf11eacc17505357
# client-floor: the newest patch of git 2.40, the oldest series with `merge-tree --write-tree --merge-base`.
GIT_CLIENT_FLOOR_VERSION=2.40.4
GIT_CLIENT_FLOOR_SHA256=8016dfeb9ba598a2e591270092b642ac70e65660606905277ea8e4c309b65d18
