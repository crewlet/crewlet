# The Chromiums the suite drives, each a Chrome for Testing build named by its version and, for each of the four
# platforms the engine is released for, the SHA-256 of that platform's zip (Google's chrome-for-testing-public
# bucket, <version>/<platform>/chrome-<platform>.zip). scripts/chromium.sh fetches them — the one recipe CI and a
# contributor's `make chromium` share — and nothing else in the tree spells their versions: the Makefile asks
# scripts/chromium.sh. The engine image never carries a Chromium, and no release changes with this file.
#
# CHROME FOR TESTING, because it is the build Google publishes for testing: versioned, never auto-updating, on Linux
# and macOS alike. A runner's own Chrome has no exact version to pin, a distribution's package moves with the
# distribution, a Chromium snapshot carries no release guarantee, and Playwright's copy (the dashboard's layout
# suites) is pinned to the Playwright release that drives it and checksummed by nothing.
#
# newest: Chrome for Testing's Stable channel. Moved when Stable names a newer MAJOR, never for a patch: a patch
# changes no protocol, and the suite drives only pages it serves on loopback.
CHROMIUM_NEWEST_VERSION=157.0.8103.50
CHROMIUM_NEWEST_SHA256_LINUX64=d17167bc092eb495a3b768c7467f27e35f625aa03834233a1663af67dcb668c9
CHROMIUM_NEWEST_SHA256_LINUX_ARM64=9539c1612121eb09c4b787f4f9d0c732357772eb22583620ffed64d50dd6c4cc
CHROMIUM_NEWEST_SHA256_MAC_X64=7b1c12bee8024f1193b28754aa0d46b7eaa08394de51bef84fd65a6cf08d61dc
CHROMIUM_NEWEST_SHA256_MAC_ARM64=aceb0578a1cc3631358b164dbbef04bf8936f96c690fb78c3ac25b7655e795e8
# floor: the newest patch of the oldest Chromium major the engine drives. Only ever moved to a newer patch of that
# major; raising the floor moves this pin to the newest patch of the new major.
CHROMIUM_FLOOR_VERSION=153.0.8010.52
CHROMIUM_FLOOR_SHA256_LINUX64=e66f66d4802a46d4a022667e668aa950e277cadbfbed4b3777915b47413a0ef9
CHROMIUM_FLOOR_SHA256_LINUX_ARM64=794441f3254273eb30d710b3eaab3cd1c7bbf1c88a40275470f6cee350881ce5
CHROMIUM_FLOOR_SHA256_MAC_X64=01130a136cb492ff32a7253b2b8db9577bd3f7543574e2d7ce1a83ed1cbed3fd
CHROMIUM_FLOOR_SHA256_MAC_ARM64=6f67faa4b34dd551b53abb6fee24edeae470ab695b0b100ddc4885ff0be6724a
