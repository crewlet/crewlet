{
  "$defs": {
    "API": {
      "additionalProperties": false,
      "properties": {
        "auth": {
          "$ref": "#/$defs/APIAuth"
        },
        "host": {
          "description": "Bind address for the HTTP surface.",
          "type": "string"
        },
        "port": {
          "description": "Bind port; 0 disables the HTTP surface entirely.",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "APIAuth": {
      "additionalProperties": false,
      "properties": {
        "allow_anonymous_read": {
          "description": "Serve reads without a token (default true).",
          "type": "boolean"
        },
        "allowed_origins": {
          "description": "CORS origins. Empty = same-origin only.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "disabled": {
          "description": "Local-dev only: serve every route unauthenticated.",
          "type": "boolean"
        },
        "tokens": {
          "description": "Accepted bearer tokens. Empty refuses every write.",
          "items": {
            "$ref": "#/$defs/APIToken"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "APIToken": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Short label recorded as the author of writes made with this token.",
          "type": "string"
        },
        "token": {
          "description": "Token value or ${VAR} reference.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "token"
      ],
      "type": "object"
    },
    "Coordination": {
      "additionalProperties": false,
      "properties": {
        "lease_ttl_seconds": {
          "description": "Lease TTL; 0 takes the measured default.",
          "minimum": 0,
          "type": "number"
        },
        "nats": {
          "$ref": "#/$defs/CoordinationNATS"
        },
        "type": {
          "description": "local (single node, default) or embedded-kv (a fleet).",
          "enum": [
            "local",
            "embedded-kv"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "CoordinationNATS": {
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "$ref": "#/$defs/StreamCluster"
        },
        "credentials": {
          "description": "Path to a NATS credentials file for an external server.",
          "type": "string"
        },
        "replicas": {
          "description": "Lease bucket replica count: 1 solo, 3 in a fleet.",
          "minimum": 0,
          "type": "integer"
        },
        "store_dir": {
          "description": "Embedded lease persistence directory. Empty = in-memory (a restart sheds this node's seats).",
          "type": "string"
        },
        "tls": {
          "$ref": "#/$defs/NATSTLS"
        },
        "token": {
          "description": "Bearer token for an external server; ${VAR} supported.",
          "type": "string"
        },
        "url": {
          "description": "External NATS URL for leases; empty embeds a member instead.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Logging": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "description": "console (default, columns and colour for a person), text (slog key=value) or json (for a log shipper).",
          "enum": [
            "console",
            "text",
            "json"
          ],
          "type": "string"
        },
        "level": {
          "description": "debug, info (default), warn or error.",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "NATSTLS": {
      "additionalProperties": false,
      "properties": {
        "ca": {
          "description": "PEM CA bundle for the server certificate; empty uses the host roots.",
          "type": "string"
        },
        "cert": {
          "description": "Client certificate PEM, for a server requiring mutual TLS. Needs key.",
          "type": "string"
        },
        "key": {
          "description": "Client private key PEM. Needs cert.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Node": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable identity of this process. Empty reads CREWLET_NODE_ID, then defaults to node-0.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Free-form node facts a seat's placement selector matches on.",
          "type": "object"
        },
        "max_concurrent": {
          "description": "Agent turns this process runs at once; 0 takes the engine default. Per node, so a fleet's ceiling is N times this.",
          "minimum": 0,
          "type": "integer"
        },
        "roles": {
          "description": "What this node does: ingress, seats, workers. Omit for all three.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SecretKey": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Stable key id, colon-free so the envelope parses.",
          "pattern": "^[A-Za-z0-9._-]+$",
          "type": "string"
        },
        "material": {
          "description": "base64(32 bytes), or a ${VAR} reference to it.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "material"
      ],
      "type": "object"
    },
    "Secrets": {
      "additionalProperties": false,
      "properties": {
        "active_key_id": {
          "description": "Which key seals new writes.",
          "type": "string"
        },
        "keys": {
          "description": "The keyring; several entries support online rotation.",
          "items": {
            "$ref": "#/$defs/SecretKey"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Store": {
      "additionalProperties": false,
      "properties": {
        "busy_timeout_seconds": {
          "description": "Lock wait before a statement fails; 0 takes the store default.",
          "minimum": 0,
          "type": "number"
        },
        "max_open_conns": {
          "description": "Connection pool bound; 0 takes the store default.",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Local database file this node owns exclusively.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Stream": {
      "additionalProperties": false,
      "properties": {
        "admin_url": {
          "description": "Pulsar admin HTTP endpoint; empty derives it from url.",
          "type": "string"
        },
        "cluster": {
          "$ref": "#/$defs/StreamCluster"
        },
        "credentials": {
          "description": "Path to a NATS credentials file for an external server.",
          "type": "string"
        },
        "event_retention_hours": {
          "description": "Event stream retention; 0 takes the queue default.",
          "minimum": 0,
          "type": "number"
        },
        "namespace": {
          "description": "Pulsar namespace under the tenant.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "replicas": {
          "description": "Stream replica count: 1 solo, 3 in a fleet.",
          "minimum": 0,
          "type": "integer"
        },
        "store_dir": {
          "description": "Embedded stream persistence directory. Empty = in-memory (nothing survives a restart).",
          "type": "string"
        },
        "tenant": {
          "description": "Pulsar tenant holding this company's topics.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "tls": {
          "$ref": "#/$defs/NATSTLS"
        },
        "tls_trust_certs": {
          "description": "CA bundle path for a pulsar+ssl broker.",
          "type": "string"
        },
        "token": {
          "description": "Bearer token for an external server; ${VAR} supported.",
          "type": "string"
        },
        "type": {
          "description": "embedded (default), nats, or pulsar.",
          "enum": [
            "embedded",
            "nats",
            "pulsar"
          ],
          "type": "string"
        },
        "url": {
          "description": "External broker URL. Required for nats/pulsar, refused for embedded.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "StreamCluster": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Cluster name shared by every member.",
          "type": "string"
        },
        "peers": {
          "description": "Route URLs of the other members.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "port": {
          "description": "Route port for cluster traffic.",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    }
  },
  "$id": "https://docs.crewlet.ai/schema/bootstrap.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "local coordination cannot serve a fleet: use coordination.type embedded-kv.",
      "if": {
        "not": {
          "properties": {
            "coordination": {
              "properties": {
                "type": {
                  "const": "embedded-kv"
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "required": [
            "coordination"
          ]
        }
      },
      "then": {
        "properties": {
          "stream": {
            "properties": {
              "cluster": {
                "properties": {
                  "peers": {
                    "maxItems": 0
                  }
                }
              },
              "type": {
                "const": "embedded"
              }
            }
          }
        }
      }
    },
    {
      "$comment": "a two-node fleet has no coordination quorum: run one node or three or more.",
      "if": {
        "properties": {
          "coordination": {
            "properties": {
              "type": {
                "const": "embedded-kv"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "coordination"
        ]
      },
      "then": {
        "not": {
          "properties": {
            "stream": {
              "properties": {
                "cluster": {
                  "properties": {
                    "peers": {
                      "maxItems": 1,
                      "minItems": 1
                    }
                  },
                  "required": [
                    "peers"
                  ]
                }
              },
              "required": [
                "cluster"
              ]
            }
          },
          "required": [
            "stream"
          ]
        }
      }
    },
    {
      "$comment": "stream.replicas \u003e 1 needs peers to replicate to.",
      "if": {
        "properties": {
          "stream": {
            "properties": {
              "replicas": {
                "minimum": 2
              }
            },
            "required": [
              "replicas"
            ]
          }
        },
        "required": [
          "stream"
        ]
      },
      "then": {
        "properties": {
          "stream": {
            "properties": {
              "cluster": {
                "properties": {
                  "peers": {
                    "minItems": 1
                  }
                },
                "required": [
                  "peers"
                ]
              }
            },
            "required": [
              "cluster"
            ]
          }
        },
        "required": [
          "stream"
        ]
      }
    },
    {
      "$comment": "an external stream needs a URL to dial.",
      "if": {
        "properties": {
          "stream": {
            "properties": {
              "type": {
                "enum": [
                  "nats",
                  "pulsar"
                ]
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "stream"
        ]
      },
      "then": {
        "properties": {
          "stream": {
            "properties": {
              "url": {
                "minLength": 1
              }
            },
            "required": [
              "url"
            ]
          }
        },
        "required": [
          "stream"
        ]
      }
    }
  ],
  "properties": {
    "api": {
      "$ref": "#/$defs/API"
    },
    "coordination": {
      "$ref": "#/$defs/Coordination"
    },
    "logging": {
      "$ref": "#/$defs/Logging"
    },
    "node": {
      "$ref": "#/$defs/Node"
    },
    "secrets": {
      "$ref": "#/$defs/Secrets"
    },
    "store": {
      "$ref": "#/$defs/Store"
    },
    "stream": {
      "$ref": "#/$defs/Stream"
    }
  },
  "title": "Crewlet bootstrap config (Tier A)",
  "type": "object"
}
